{
  "name": "gym-routines-backend",
  "version": "0.2.0",
  "private": true,
  "description": "App de rutinas para gimnasio (sedes Martínez y Olivos): generador, reemplazos con IA, agente admin y progresión mensual",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "dataset:fetch": "bash scripts/fetch-dataset.sh",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "import:dry": "node scripts/import-exercises.js --dry-run",
    "import": "node --env-file-if-exists=.env scripts/import-exercises.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "express": "^4.22.3",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0"
  }
}
