# Copiá este archivo a .env y completalo. NUNCA subas el .env al repo.

# Cadena de conexión de Postgres (ej: Neon, plan gratuito)
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# Clave del panel de administrador (/admin). Larga y que solo conozcas vos (mínimo 12 caracteres).
# Sugerencia para generarla:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=

# IA (opcional). Sin esta clave la app funciona igual: los reemplazos usan reglas y el agente admin queda apagado.
OPENROUTER_API_KEY=
# Modelo de OpenRouter (podés cambiarlo cuando quieras)
AI_MODEL=anthropic/claude-sonnet-4.5

# Carpeta del dataset descargado (npm run dataset:fetch). De ahí salen los GIFs y miniaturas.
DATASET_DIR=./dataset

# Si algún día alojás los GIFs en otro lado (CDN/bucket), poné acá la URL base. Por defecto: /media
# MEDIA_BASE_URL=https://cdn.tudominio.com

# URL pública de la app (para armar los links personales de los socios)
# PUBLIC_URL=https://rutinas.tudominio.com

# Poné 1 si la app corre detrás de un proxy (Render, Railway, Fly...) para que el límite de intentos use la IP real
# TRUST_PROXY=1

PORT=3000
